<Window x:Class="SpaceIsland.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SpaceIsland.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="空间岛" Width="880" Height="800" MinWidth="760" MinHeight="620"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStyle="None" Background="{DynamicResource Brush.Page}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrush" />
        <conv:InfoToCollapsedConverter x:Key="InfoToCollapsed" />
        <conv:InfoToVisibleConverter x:Key="InfoToVisible" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:BoolToTextConverter x:Key="AdminBadge" />

        <!-- 清理项一行 -->
        <DataTemplate x:Key="ItemRow">
            <Border x:Name="Row" CornerRadius="10" Padding="14,8" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource RoundCheck}"
                              IsChecked="{Binding Selected, Mode=TwoWay}"
                              Visibility="{Binding Risk, Converter={StaticResource InfoToCollapsed}}"
                              Margin="0,0,12,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Subtle}"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="需管理员" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextSoft}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.TextSoft}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding SizeLabel}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                        <TextBlock Text="{Binding FileCountText}" FontSize="10.5" Margin="0,2,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.TextSoft}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Grid.Row="0" Margin="24,18,16,2" Background="Transparent"
              MouseLeftButtonDown="OnHeaderDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource Brush.AccentGradient}">
                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="空间岛" Style="{StaticResource H1}" />
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10.5" Margin="8,4,0,0"
                               Foreground="{DynamicResource Brush.TextSoft}" />
                </StackPanel>
                <TextBlock Text="C 盘缓存清理 · 只删能自动重建的东西" FontSize="11.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.TextSoft}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource IconButton}" Click="OnToggleTheme" Content="&#xE708;"
                        ToolTip="切换深浅色" />
                <Button Style="{StaticResource IconButton}" Click="OnMinimize" Content="&#xE921;"
                        ToolTip="最小化" />
                <Button Style="{StaticResource IconButton}" Click="OnClose" Content="&#xE711;"
                        ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <!-- ================= 内容 ================= -->
        <ScrollViewer Grid.Row="1" Padding="24,10,24,10" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- C 盘容量 -->
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="C:" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="系统盘" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSoft}" />
                            </StackPanel>
                            <TextBlock x:Name="DiskHeadline" Text="—" FontSize="13" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </Grid>

                        <ProgressBar Grid.Row="1" x:Name="DiskBar" Style="{StaticResource ThinBar}" Height="8"
                                     Margin="0,12,0,0" Minimum="0" Maximum="100" />

                        <Grid Grid.Row="2" Margin="0,9,0,0">
                            <TextBlock x:Name="DiskFreeText" Text="—" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                            <TextBlock x:Name="DiskPercentText" Text="" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 可释放合计 -->
                <Grid Margin="2,18,2,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="可释放" FontSize="13" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Brush.TextSoft}" />
                        <TextBlock x:Name="TotalText" Text="—" FontSize="24" FontWeight="Bold" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>
                    <TextBlock x:Name="ScanStateText" Text="准备就绪" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSoft}" />
                </Grid>

                <!-- 可安全清理 -->
                <Border Style="{StaticResource Card}" Padding="6,10,6,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="12,2,12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="可直接清理" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <TextBlock x:Name="SafeSubtotal" Text="" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                        </Grid>

                        <ItemsControl x:Name="SafeList" ItemTemplate="{StaticResource ItemRow}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasContent}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 需要确认 -->
                <Border Style="{StaticResource Card}" Padding="6,10,6,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="12,2,12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Warn}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="需要你确认" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="清掉要重新下载" FontSize="11" Margin="8,1,0,0"
                                           Foreground="{DynamicResource Brush.TextSoft}" />
                            </StackPanel>
                            <TextBlock x:Name="CautionSubtotal" Text="" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextSoft}" />
                        </Grid>

                        <ItemsControl x:Name="CautionList" ItemTemplate="{StaticResource ItemRow}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasContent}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 仅查看 -->
                <Border Style="{StaticResource Card}" Padding="6,10,6,8" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="12,2,12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.TextSoft}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="不要手删的系统占用" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="InfoList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="14,10" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Brush.TextSoft}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="打开目录" Style="{StaticResource GhostButton}"
                                                    Padding="12,6" FontSize="11.5" Click="OnOpenItemFolder"
                                                    Tag="{Binding}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= 底部 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Page}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0"
                Padding="0,12,0,16">
        <Grid Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重新扫描" Style="{StaticResource GhostButton}" Click="OnRescan" />
                <TextBlock x:Name="AdminHint" Text="" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warn}" />
            </StackPanel>

            <Button Grid.Column="2" x:Name="CleanButton" Content="开始清理" Style="{StaticResource AccentButton}"
                    Click="OnClean" IsEnabled="False" />
        </Grid>
        </Border>
    </Grid>
</Window>
